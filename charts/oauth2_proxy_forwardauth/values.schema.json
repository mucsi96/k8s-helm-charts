{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "oauth2-proxy"],
  "properties": {
    "publicApiRoutes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "service", "port"],
        "properties": {
          "path": {"type": "string", "pattern": "^/api/[^?# ]+$"},
          "service": {"type": "string", "minLength": 1},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    },
    "machineRoutes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "method", "service", "port"],
        "properties": {
          "path": {"type": "string", "pattern": "^/api/[^?# ]+$"},
          "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
          "service": {"type": "string", "minLength": 1},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    },
    "global": {
      "type": "object",
      "required": ["forwardAuth"],
      "properties": {
        "forwardAuth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "issuerURL", "credentialsSecret", "mode", "trustedProxyCIDRs"],
          "properties": {
            "host": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
            "issuerURL": {"type": "string", "pattern": "^https://[^?# ]+$"},
            "credentialsSecret": {"type": "string", "minLength": 1},
            "mode": {"enum": ["api-token", "email-header", "login-gate"]},
            "apiScope": {"type": "string"},
            "cookieName": {"type": "string", "pattern": "^$|^__Host-[a-zA-Z0-9_-]+$"},
            "cookieRefresh": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
            "cookieExpire": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
            "trustedProxyCIDRs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
          },
          "allOf": [
            {"if": {"properties": {"mode": {"const": "api-token"}}},
             "then": {"required": ["apiScope"], "properties": {"apiScope": {"pattern": "^api://[^ /]+/[^ ]+$"}}},
             "else": {"properties": {"apiScope": {"const": ""}}}}
          ]
        }
      }
    },
    "oauth2-proxy": {
      "type": "object",
      "properties": {
        "config": {"type": "object", "properties": {
          "existingSecret": {"const": "{{ .Values.global.forwardAuth.credentialsSecret }}"},
          "configFile": {"const": "{{ include \"forwardauth.legacyConfig\" . }}"}
        }},
        "alphaConfig": {"type": "object", "properties": {
          "enabled": {"const": true},
          "configFile": {"const": "{{ include \"forwardauth.alphaConfig\" . }}"},
          "configData": {"maxProperties": 0}
        }},
        "authenticatedEmailsFile": {"type": "object", "properties": {"enabled": {"const": false}}},
        "ingress": {"type": "object", "properties": {"enabled": {"const": false}}},
        "gatewayApi": {"type": "object", "properties": {"enabled": {"const": false}}},
        "sessionStorage": {"type": "object", "properties": {
          "type": {"const": "redis"},
          "redis": {"type": "object", "properties": {
            "existingSecret": {"type": "string", "minLength": 1},
            "standalone": {"type": "object", "properties": {"connectionUrl": {"type": "string", "pattern": "^rediss?://.+"}}}
          }}
        }}
      }
    }
  }
}
