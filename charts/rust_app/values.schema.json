{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "host"],
  "properties": {
    "image": {"type": "string", "minLength": 1},
    "host": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
    "appPort": {"type": "integer", "minimum": 1, "maximum": 65535},
    "basePath": {"type": "string", "pattern": "^/"},
    "replicaCount": {"type": "integer", "minimum": 0},
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
    "serviceAccountName": {"type": "string"},
    "clientId": {"type": "string"},
    "serviceAccount": {"type": "object", "properties": {
      "create": {"type": "boolean"},
      "automountServiceAccountToken": {"type": "boolean"},
      "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
    }},
    "env": {"type": "object", "propertyNames": {"not": {"enum": ["LISTEN_ADDR", "BASE_PATH", "K8S_POD_IP"]}}, "additionalProperties": {"type": ["string", "number", "boolean"]}},
    "envFrom": {"type": "array", "items": {"type": "object"}},
    "configFile": {"type": "array", "items": {"type": "object", "required": ["name", "mountPath", "data"], "properties": {
      "name": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"},
      "mountPath": {"type": "string", "pattern": "^/.+"},
      "data": {"type": "string", "pattern": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
    }}},
    "persistentVolumeClaims": {"type": "array", "items": {"type": "object", "required": ["name", "mountPath", "accessMode", "storageClassName", "storage"], "properties": {
      "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
      "mountPath": {"type": "string", "pattern": "^/.+"},
      "accessMode": {"enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]},
      "storageClassName": {"type": "string"},
      "volumeName": {"type": "string"},
      "storage": {"type": "string", "minLength": 1}
    }}},
    "extraVolumes": {"type": "array", "items": {"type": "object"}},
    "extraVolumeMounts": {"type": "array", "items": {"type": "object"}},
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "lifecycle": {"type": "object"},
    "health": {"type": "object", "properties": {
      "livenessPath": {"type": "string", "pattern": "^/"},
      "readinessPath": {"type": "string", "pattern": "^/"}
    }}
  },
  "allOf": [
    {"if": {"properties": {"serviceAccount": {"properties": {"create": {"const": false}}}}},
     "then": {"properties": {"serviceAccountName": {"type": "string", "minLength": 1}}}}
  ]
}
